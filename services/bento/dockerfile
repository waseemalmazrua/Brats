# =========================
# 🧱 Stage 1: Builder
# =========================
FROM python:3.10-slim AS builder

RUN apt-get update && apt-get upgrade -y && \
    apt-get clean && rm -rf /var/lib/apt/lists/

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock* ./

RUN uv sync --frozen --no-cache && \
    rm -rf /root/.cache

# =========================
# 🚀 Stage 2: Runtime
# =========================
FROM python:3.10-slim

RUN apt-get update && apt-get upgrade -y && \
    apt-get clean && rm -rf /var/lib/apt/lists/

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1

COPY --from=builder /app/.venv /app/.venv

COPY ./services/bento /app
COPY ./app /app/app

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH=/app

ARG GCP_SA_KEY
COPY ./services/bento/download_model.py /tmp/download_model.py
RUN echo "${GCP_SA_KEY}" > /tmp/sa_key.json && \
    GOOGLE_APPLICATION_CREDENTIALS=/tmp/sa_key.json python /tmp/download_model.py && \
    bentoml models import /tmp/brats_model.bentomodel && \
    rm /tmp/brats_model.bentomodel /tmp/sa_key.json /tmp/download_model.py

EXPOSE 3000

CMD ["bentoml", "serve", "service:BratsService", "--port", "3000"]